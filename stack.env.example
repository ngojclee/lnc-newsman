# LNC Newsman — Portainer stack env (names only; values are generated at deploy time).
# Copy into Portainer → Stack → Environment variables. Nothing here is committed with a value.

DATA_DIR=/share/Docker
PORT=8462
TZ=Asia/Ho_Chi_Minh
REGIONS_DIR=/data/regions

# Generated at deploy; stored outside the repo for the owner.
MANAGEMENT_KEY=
LNC_API_KEYS=
LNC_MASTER_KEY=
LNC_MASTER_KEY_OLD=

# LAN HTTP for now. Set true only when served over HTTPS by a proxy.
COOKIE_SECURE=false
ALLOWED_HOSTS=

# Optional (P5/P6): LNC Agent Hub provider. Absence means "rules only".
HUB_BASE_URL=
HUB_ALLOWED_HOSTS=
HUB_MODEL_CLASSIFY=
HUB_MODEL_SUMMARISE=
HUB_MODEL_ANALYSE=
HUB_AGENT_ID=
HUB_TIMEOUT_SECONDS=
LLM_DAILY_TOKEN_BUDGET=

# Optional (P2): SEC EDGAR User-Agent, owner-filled. Empty keeps the EDGAR connectors off.
SEC_USER_AGENT=
