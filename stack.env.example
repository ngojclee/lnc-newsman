# LNC Newsman — Portainer stack env (names only; values are generated at deploy time).
# Copy into Portainer → Stack → Environment variables. Nothing here is committed with a value.

DATA_DIR=/share/Docker
PORT=8462
TZ=Asia/Ho_Chi_Minh
REGIONS_DIR=/data/regions

# Generated at deploy; stored outside the repo for the owner.
MANAGEMENT_KEY=
LNC_API_KEYS=
LNC_MASTER_KEY=
LNC_MASTER_KEY_OLD=

# Served over HTTPS by the edge proxy: the session cookie is Secure-only, so a
# plain http:// access to 10.20.2.1:8462 will not stay logged in.
COOKIE_SECURE=true
ALLOWED_HOSTS=newsman.lengoc.me,10.20.2.1
# Socket peers whose X-Forwarded-For is believed for login throttling. Empty = trust
# nobody and count per TCP peer (one shared proxy address then locks everyone).
TRUSTED_PROXIES=10.20.0.3

# Business MCP Hub connector (P8). All four are `env_or_cfg`: an empty value means
# "use whatever the owner set in /admin" (the two secrets live in the sealed store as
# `connector-bearer` and `delegation-secret`, so they can be pasted there instead of
# here and need no redeploy). Leave both secret lines empty and pair from /admin if
# that is preferred — the connector stays unusable (401) until both are set.
CONNECTOR_BEARER=
DELEGATION_SECRET=
# The audience the Hub signs for. Must match the connector record on the Hub.
CONNECTOR_AUDIENCE=lnc-newsman
# Hard ceiling on the scopes the Hub may delegate. There is exactly one read scope;
# a write scope does not exist in this build and is refused if demanded.
CONNECTOR_MAX_SCOPES=newsman:read

# Optional (P5/P6): LNC Agent Hub provider. Absence means "rules only".
HUB_BASE_URL=
HUB_ALLOWED_HOSTS=
HUB_MODEL_CLASSIFY=
HUB_MODEL_SUMMARISE=
HUB_MODEL_ANALYSE=
HUB_AGENT_ID=
HUB_TIMEOUT_SECONDS=
LLM_DAILY_TOKEN_BUDGET=

# Optional (P2): SEC EDGAR User-Agent, owner-filled. Empty keeps the EDGAR connectors off.
SEC_USER_AGENT=
